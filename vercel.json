{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js",           "use": "@vercel/node" },
    { "src": "*.html",                "use": "@vercel/static" },
    { "src": "fonts/**",              "use": "@vercel/static" },
    { "src": "assets/**",             "use": "@vercel/static" },
    { "src": "*.png",                 "use": "@vercel/static" },
    { "src": "*.jpg",                 "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/pb/search",              "dest": "/api/pocketbase/search.js" },
    { "src": "/api/pb/artigos-disponiveis", "dest": "/api/pocketbase/artigos-disponiveis.js" },
    { "src": "/api/pb/mark-done",           "dest": "/api/pocketbase/mark-done.js" },
    { "src": "/api/pb/update-cargo",        "dest": "/api/pocketbase/update-cargo.js" },
    { "src": "/api/proxy-image",            "dest": "/api/proxy-image.js" },
    { "src": "/api/summarize",              "dest": "/api/summarize.js" },
    { "src": "/api/copywrite",              "dest": "/api/copywrite.js" },
    { "src": "/api/stock-images",           "dest": "/api/stock-images.js" },
    { "src": "/api/conselho-image",         "dest": "/api/conselho-image.js" },
    { "src": "/copywriter",                 "dest": "/copywriter.html" },
    { "src": "/app",                        "dest": "/app.html" },
    { "src": "/seletor-prompts",            "dest": "/seletor-prompts.html" },
    { "src": "/remove-fundo",               "dest": "/remove-fundo.html" },
    { "src": "/fonts/(.*)",                 "dest": "/fonts/$1" },
    { "src": "/assets/(.*)",                "dest": "/assets/$1" },
    { "src": "/logo-rl.png",               "dest": "/logo-rl.png" },
    { "src": "/cta-photo.jpg",             "dest": "/cta-photo.jpg" },
    { "src": "/",                           "dest": "/index.html" }
  ]
}
